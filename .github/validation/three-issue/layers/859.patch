+
+        def __init__(self):
+            self.chunks = list(_HARMONY_CHUNKS)
+
+        async def stream_chat(self, messages, **kwargs):
+            text = ""
+            for i, delta in enumerate(self.chunks):
+                text += delta
+                yield GenerationOutput(
